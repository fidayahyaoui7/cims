        "name": "الأشعة التداخلية",
        "description": "إجراءات طبية متقدمة تستخدم الأشعة لتوجيه الإجراءات الجراحية",
        "availability": "محدودة",
        "notes": "متوفرة في المستشفيات الجامعية الكبرى"
      }
    },
    "hospital_categories": {
      "district": {
        "title": "مستشفيات الأقسام",
        "description": "خدمات تصوير أساسية: الأشعة السينية والموجات فوق الصوتية. تخدم المناطق الريفية والبلدات الصغيرة."
      },
      "regional": {
        "title": "المستشفيات الجهوية",
        "description": "تشمل نطاقًا أوسع من الخدمات: الأشعة السينية، الموجات فوق الصوتية، التصوير المقطعي، تصوير الثدي. يتوفر مستشفى جهوي واحد على الأقل في كل ولاية."
      },
      "university": {
        "title": "المستشفيات الجامعية (المستشفيات الجامعية المركزية)",
        "description": "تشمل كامل نطاق خدمات الأشعة: التصوير المقطعي، الرنين المغناطيسي، التصوير المقطعي بالإصدار البوزيتروني (للأورام)، الأشعة التداخلية، التدريب والبحث. تتركز بشكل رئيسي في تونس، سوسة، المنستير وصفاقس."
      }
    },
