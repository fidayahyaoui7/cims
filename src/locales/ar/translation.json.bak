        "availability": "محدودة",
        "notes": "متوفرة في المستشفيات الجهوية والجامعية"
      },
      "ct_scan": {
        "name": "التصوير المقطعي المحوسب",
        "description": "متوفر في المستشفيات الجهوية والجامعية لفحص الإصابات، الأورام، والتشخيصات المعقدة.",
        "availability": "~9 لكل مليون",
        "notes": "متوفر في المستشفيات الجهوية والجامعية"
      },
      "mri": {
        "name": "الرنين المغناطيسي",
