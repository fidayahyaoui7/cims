/* Modern Center Detail Page Styles */
:root {
  --primary: #2563eb;
  --primary-hover: #1d4ed8;
  --secondary: #4b5563;
  --light-gray: #f3f4f6;
  --border-color: #e5e7eb;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --radius: 8px;
  --transition: all 0.2s ease-in-out;
}

.center-detail-page {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1rem;
  position: relative;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  line-height: 1.6;
  color: #333;
}

/* Header Styles */
.center-header {
  margin-bottom: 2rem;
  padding: 1.5rem;
  background: white;
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.center-header h1 {
  margin: 0 0 0.5rem 0;
  color: #1a202c;
  font-size: 1.875rem;
}

.center-address {
  color: #4a5568;
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Status Badge */
.status-badge {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.875rem;
  font-weight: 600;
  margin-left: 1rem;
}

.status-badge.open {
  background-color: #dcfce7;
  color: #166534;
}

.status-badge.closed {
  background-color: #fee2e2;
  color: #991b1b;
}

/* Opening Hours Section */
.opening-hours-section {
  margin-top: 1.5rem;
  padding: 1.25rem;
  background-color: #f8fafc;
  border-radius: 0.5rem;
  border-left: 4px solid var(--primary);
}

.opening-hours-section h3 {
  margin-top: 0;
  margin-bottom: 1rem;
  color: #1e40af;
  font-size: 1.25rem;
}

.opening-hours {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.opening-hour-row {
  display: flex;
  justify-content: space-between;
  padding: 0.5rem 0;
  border-bottom: 1px solid #e2e8f0;
}

.opening-hour-row:last-child {
  border-bottom: none;
}

.opening-hour-row .day {
  font-weight: 500;
  color: #4a5568;
}

.opening-hour-row .hours {
  color: #2d3748;
  font-weight: 500;
}

.opening-hour-row.current-day {
  background-color: #eff6ff;
  margin: -0.5rem -1.25rem;
  padding: 0.5rem 1.25rem;
  border-radius: 0.375rem;
}

.opening-hour-row.current-day .day,
.opening-hour-row.current-day .hours {
  color: #1e40af;
  font-weight: 600;
}

/* Center Content Layout */
.center-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  margin-top: 2rem;
}

.info-section {
  background: white;
  border-radius: 0.5rem;
  padding: 1.5rem;
  box-shadow: var(--shadow-sm);
  margin-bottom: 1.5rem;
}

.info-section h2 {
  margin-top: 0;
  margin-bottom: 1.25rem;
  color: #1a202c;
  font-size: 1.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid #e2e8f0;
}

.info-card {
  display: grid;
  gap: 1rem;
}

.info-item {
  display: flex;
  gap: 0.75rem;
  align-items: flex-start;
}

.info-label {
  font-weight: 600;
  color: #4a5568;
  min-width: 120px;
}

.info-value {
  flex: 1;
  color: #2d3748;
}

/* Services Grid */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1rem;
  margin-top: 1rem;
}

.service-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem;
  background: #f8fafc;
  border-radius: 0.375rem;
  transition: all 0.2s;
  border: 1px solid #e2e8f0;
}

.service-item:hover {
  transform: translateY(-2px);
  box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
  border-color: #cbd5e0;
}

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: #e0f2fe;
  color: #0369a1;
  font-weight: 600;
  font-size: 0.875rem;
}

.service-name {
  font-size: 0.9375rem;
  color: #2d3748;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  gap: 1rem;
  margin-top: 2rem;
  flex-wrap: wrap;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.5rem;
  border-radius: 0.375rem;
  font-weight: 500;
  font-size: 1rem;
  line-height: 1.5;
  cursor: pointer;
  transition: all 0.2s;
  text-decoration: none;
  border: 1px solid transparent;
}

.btn-primary {
  background-color: #2563eb;
  color: white;
}

.btn-primary:hover {
  background-color: #1d4ed8;
  transform: translateY(-1px);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

.btn-secondary {
  background-color: white;
  color: #2563eb;
  border: 1px solid #2563eb;
}

.btn-secondary:hover {
  background-color: #f8fafc;
  transform: translateY(-1px);
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.btn-success {
  background-color: #10b981;
  color: white;
}

.btn-success:hover {
  background-color: #0d9f6e;
  transform: translateY(-1px);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

/* Loading State */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 300px;
  gap: 1rem;
  color: #4a5568;
}

.loading-spinner {
  width: 3rem;
  height: 3rem;
  border: 3px solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Error State */
.error-message {
  text-align: center;
  padding: 2rem;
  background: #fef2f2;
  border-radius: 0.5rem;
  color: #991b1b;
  margin: 2rem 0;
}

.error-message h2 {
  margin-top: 0;
  color: #b91c1c;
}

.error-message .btn-light {
  margin-top: 1rem;
  background: white;
  border: 1px solid #e5e7eb;
  padding: 0.5rem 1rem;
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all 0.2s;
}

.error-message .btn-light:hover {
  background: #f3f4f6;
}

/* Responsive Design */
@media (max-width: 1024px) {
  .center-content {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .center-header h1 {
    font-size: 1.5rem;
  }
  
  .services-grid {
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  }
  
  .action-buttons {
    flex-direction: column;
  }
  
  .btn {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .center-detail-page {
    padding: 1rem 0.75rem;
  }
  
  .center-header {
    padding: 1rem;
  }
  
  .info-item {
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .info-label {
    min-width: auto;
  }
}
